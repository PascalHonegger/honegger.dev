{
	"name": "honegger.dev",
	"version": "0.0.1",
	"private": "true",
	"license": "Apache-2.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"test:update": "playwright test --update-snapshots",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check . && oxlint .",
		"format": "oxfmt .",
		"prepare": "husky .husky"
	},
	"devDependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@playwright/test": "^1.64.1",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/dom-view-transitions": "^1.0.6",
		"autoprefixer": "^10.6.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"oxfmt",
			"oxlint --fix --quiet"
		],
		"*.{svelte,json,html}": [
			"oxfmt"
		]
	},
	"packageManager": "pnpm@12.16.1"
}
